# URL directa (no pooled) de Neon. Alembic necesita una conexion directa.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Nombre local resuelto por tu red, o la IP LAN fija de esta computadora.
RUMBO_HOST=rumbo.home
